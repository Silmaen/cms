# Variables de l'environnement Docker local (lues automatiquement par docker compose).

# UID/GID de l'utilisateur hôte — alignés sur l'utilisateur Apache des conteneurs
# pour que Smarty puisse écrire dans templates_c/ et cache/ (volumes montés).
# En cas de changement de machine : mettre à jour avec `id -u` / `id -g`.
UID=1001
GID=1001

# Ports publiés sur la machine hôte
WEB_PROD_PORT=8080
WEB_RECETTE_PORT=8081
PMA_PORT=8082

# Ports MySQL exposés (accès direct depuis l'hôte, ex. client SQL externe)
DB_PROD_PORT=3307
DB_RECETTE_PORT=3308
