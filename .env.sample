# Modèle du fichier .env — surcharges spécifiques à TA machine.
#
#   cp .env.sample .env      puis ajuste si besoin.
#
# .env (gitignoré) ÉCRASE .env.defaults (committé, valeurs partagées). Compose lit
# les deux via COMPOSE_ENV_FILES=.env.defaults,.env (voir docker/README.md).
# N'y mets QUE ce qui diffère d'une machine à l'autre.

# UID/GID de l'utilisateur hôte — pour que Smarty puisse écrire dans templates_c/
# et cache/ (volumes montés). Renseigner avec `id -u` / `id -g`.
UID=1000
GID=1000

# Exemples de surcharges ponctuelles (décommenter au besoin) :
# WEB_PORT=8090
# CDF_ENV=recette
