// --- Base de données de PRODUCTION (mutualisé OVH) ---
define('utilisateur', "VOTRE_UTILISATEUR_MYSQL");
define('mdp',         "VOTRE_MOT_DE_PASSE_MYSQL");
define('serveur',     "VOTRE_HOTE_MYSQL");        // ex. monbase.mysql.db
define('bdd',         "VOTRE_NOM_DE_BASE");

// --- Alternative : base MySQL locale (développement) ---
/*
