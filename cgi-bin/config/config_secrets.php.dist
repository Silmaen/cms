//
// MODÈLE de secrets BDD — à copier en `config_secrets.php` sur CHAQUE serveur OVH,
// puis renseigner UNIQUEMENT les identifiants de la base de CE serveur :
//
//   cp config_secrets.php.dist config_secrets.php
//
// `config_secrets.php` est ignoré par git (voir .gitignore) : il n'est jamais
// versionné ni écrasé par le déploiement automatique (checkout git). Chaque
// hébergement (prod / recette / test) ne connaît ainsi que sa propre base.
//
// EN LOCAL (Docker), ce fichier est INUTILE : les identifiants proviennent des
// variables d'environnement CDF_DB_* définies dans docker-compose.yml.
//

define('serveur',     "VOTRE_HOTE_MYSQL");        // ex. cdfgenaytbbdd.mysql.db
define('bdd',         "VOTRE_NOM_DE_BASE");
define('utilisateur', "VOTRE_UTILISATEUR_MYSQL");
